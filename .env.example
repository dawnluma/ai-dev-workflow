# =============================================================================
# AI Dev Workflow - Environment Variable Template
# =============================================================================
#
# This file is SAFE to commit to a public repository because it must contain
# placeholders and example values only.
#
# Setup:
#   1. Copy this file to `.env`
#   2. Fill `.env` with your real local values
#   3. NEVER commit `.env`
#
# Example:
#   cp .env.example .env
#
# Make sure `.gitignore` contains:
#   .env
#
# =============================================================================


# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------

# Provider used by the Idea-to-Ticket workflow.
#
# Example values:
#   openai
#   anthropic
#   xai
#   local
#
# The first MVP does not need to support every provider.
LLM_PROVIDER=openai


# Model used by the selected provider.
#
# Keep this configurable instead of hard-coding a model name in application code.
#
# Example:
# LLM_MODEL=<your-model-name>
LLM_MODEL=


# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------

# Required only when the workflow calls the OpenAI API directly.
#
# Do NOT place a real key in this example file.
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# Anthropic / Claude
# -----------------------------------------------------------------------------

# Optional future integration.
#
# Claude Code subscription access and Anthropic API access are separate concepts.
# Only populate this when the application explicitly uses the Anthropic API.
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# xAI / Grok
# -----------------------------------------------------------------------------

# Optional future integration.
XAI_API_KEY=


# -----------------------------------------------------------------------------
# Local Model Provider
# -----------------------------------------------------------------------------

# Optional future local-model endpoint, for example when using Ollama.
#
# Example:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_BASE_URL=


# Optional local model name.
#
# Example:
# LOCAL_LLM_MODEL=<local-model-name>
LOCAL_LLM_MODEL=


# -----------------------------------------------------------------------------
# GitHub
# -----------------------------------------------------------------------------

# Repository that the Idea-to-Ticket workflow should work with.
#
# Format:
#   owner/repository
#
# Example:
# GITHUB_REPOSITORY=example-user/example-project
GITHUB_REPOSITORY=


# Optional GitHub token.
#
# Leave blank when authentication is handled by GitHub CLI (`gh auth login`).
#
# Never commit a real token.
GITHUB_TOKEN=


# -----------------------------------------------------------------------------
# Workflow Defaults
# -----------------------------------------------------------------------------

# Default project name used when generating ticket drafts.
#
# Example:
# DEFAULT_PROJECT=MarketLens
DEFAULT_PROJECT=


# Default ticket priority when no recommendation is available.
#
# Suggested values:
#   now
#   next
#   later
#   parked
DEFAULT_PRIORITY=next


# Require explicit human approval before creating or modifying a GitHub Issue.
#
# Keep this enabled.
REQUIRE_HUMAN_APPROVAL=true


# -----------------------------------------------------------------------------
# Application Behaviour
# -----------------------------------------------------------------------------

# Application environment.
#
# Suggested values:
#   development
#   test
#   production
APP_ENV=development


# Logging level.
#
# Suggested values:
#   DEBUG
#   INFO
#   WARNING
#   ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# IMPORTANT
# -----------------------------------------------------------------------------
#
# This file is documentation and configuration scaffolding only.
#
# NEVER put real secrets here.
#
# Real values belong in:
#
#   .env
#
# and `.env` must be excluded by `.gitignore`.
#
# Public:
#   .env.example   ✅
#
# Private / local only:
#   .env           ❌ never commit
#
# =============================================================================
