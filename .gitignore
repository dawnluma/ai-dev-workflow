# =============================================================================
# AI Dev Workflow - .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets / Local Environment Variables
# -----------------------------------------------------------------------------

# Real local environment files must never be committed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Ignore other .env variants, but keep the public template.
.env.*
!.env.example


# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------

# Project-root temporary working folder:
# ai-dev-workflow/temp/
#
# The leading slash means only the temp folder at the repository root
# is ignored.
/temp/


# Common temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~


# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------

*.log
logs/


# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checker / linter caches
.mypy_cache/
.ruff_cache/
.pyright/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/


# -----------------------------------------------------------------------------
# Node.js / JavaScript
# -----------------------------------------------------------------------------

# May be useful later if Node-based tooling is added.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# -----------------------------------------------------------------------------
# IDE / Editor Local Files
# -----------------------------------------------------------------------------

# JetBrains IDEs
.idea/

# VS Code / Cursor user-local workspace state
# Keep project-level settings only if you intentionally want to share them.
*.code-workspace

# Visual Studio
.vs/


# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory


# -----------------------------------------------------------------------------
# Test / Tool Caches
# -----------------------------------------------------------------------------

.cache/
.tox/
.nox/


# -----------------------------------------------------------------------------
# Local Databases / Runtime State
# -----------------------------------------------------------------------------

*.sqlite
*.sqlite3
*.db


# -----------------------------------------------------------------------------
# Local Output / Generated Runtime Files
# -----------------------------------------------------------------------------

output/
artifacts/
run-history/


# -----------------------------------------------------------------------------
# Important: intentionally NOT ignored
# -----------------------------------------------------------------------------
#
# These files/folders are expected to be safe to commit when they contain
# generic/public content:
#
#   .env.example
#   README.md
#   AGENTS.md
#   docs/
#   examples/
#   prompts/
#   schemas/
#   tests/
#   .ai/
#
# Do not place secrets, tokens, private company data, or production credentials
# in any tracked file, including .ai/ or examples/.
#
# =============================================================================
